# Waggles (web) — REQUIRED. There is no default backend.
#
# Copy this to the local dotenv file Next reads and point it at YOUR OWN
# Supabase project. The app throws a clear error if these are unset: it will
# not fall back to anyone else's server (WAGGLES_FORK_PLAN v0.2, ruling #4).
#
# The anon/publishable key is client-safe by design (RLS-gated, ships in the
# browser bundle) — but it names one specific backend, so it stays out of git.
# The local dotenv file is gitignored; never commit a real key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: serve under a sub-path (e.g. /talk). Baked in at build time.
NEXT_PUBLIC_BASE_PATH=

# REQUIRED for a production build: the app refuses to build with fixture
# data, so a real deployment must set this to `live`. Inlined at build time —
# changing it without a rebuild does nothing. Leave unset for local mock dev.
NEXT_PUBLIC_DATA_SOURCE=

# The address YOUR instance is served from. Used only for metadata and sitemap
# URLs. Defaults to http://localhost:3000 — deliberately not a vendor domain.
NEXT_PUBLIC_SITE_URL=
