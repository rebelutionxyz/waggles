# Waggles — optional build-time PRE-FILLS for the setup screen.
#
# NOTHING HERE IS REQUIRED. Waggles has no default backend (WAGGLES_FORK_PLAN
# v0.2, RESOLVED ruling #4): with this file absent, the setup screen starts
# empty and the app cannot reach any server until a Bee enters their own host.
# These variables only save an operator's users a paste when that operator
# builds Waggles for their own deployment.
#
# Copy this file to the real dotenv name and fill in YOUR OWN project. That
# file is gitignored; never commit a real key. The anon/publishable key is
# client-safe by design (RLS-gated, ships in the bundle) — but it still names
# one specific backend, so it stays out of git.

# Your Supabase project URL, e.g. https://yourproject.supabase.co
EXPO_PUBLIC_WAGGLES_HOST_URL=

# That project's anon / publishable key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The reference deployment for this fork is the project named in the WAGGLES_F2
# dispatch; its URL and publishable key are recorded there and in
# WAGGLES_F2-ACK rather than in this file.
